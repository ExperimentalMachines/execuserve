<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the phone in a backup or a device-to-device transfer: the settings hold API
    keys, and the models are gigabytes the new phone can download itself. From Android 12,
    allowBackup="false" no longer covers device transfer; these rules do.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
